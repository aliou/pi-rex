{
  "name": "@aliou/pi-program-status",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "program-status"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aliou/pi-program-status"
  },
  "pi": {
    "extensions": [
      "./extensions/program-status/index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "extensions",
    "!extensions/**/*.test.ts",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aliou/biome-plugins": "^0.18.1",
    "@biomejs/biome": "^2.6.4",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^25.0.10",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "packageManager": "pnpm@11.5.1"
}
